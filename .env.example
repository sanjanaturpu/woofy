# PostgreSQL connection (create the "woofy" database first).
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/woofy_db

# Generate long random values and keep this file private.
WOOFY_JWT_SECRET=replace-with-a-long-random-secret
WOOFY_ADMIN_SETUP_KEY=replace-with-a-separate-one-time-setup-secret

# Local Ollama settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
WOOFY_AI_MODEL=qwen3.5:4b
